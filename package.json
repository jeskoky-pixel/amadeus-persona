{
  "name": "@amadeus/persona",
  "version": "1.2.0",
  "private": true,
  "description": "Amadeus Persona v0.1: trusted Workspace/QQ-Scene persona injection, revisioned JSON storage, owner-only management API, and five-page Web Console for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "scripts",
    "test",
    "cordis.patch.yml",
    "docs/IMPLEMENTATION_PLAN.md",
    "docs/UI_REPORT.md",
    "docs/I18N_IMPLEMENTATION.md",
    "README.md",
    "LICENSE",
    "docs/UPGRADE_POLICY.md",
    "docs/DATA_MIGRATION.md",
    "docs/RELEASE_CHECKLIST.md",
    "docs/INSTALL_V1_2.md",
    "docs/RELEASE_NOTES.md",
    "scripts/release-audit.mjs",
    "screenshots.json",
    "assets/market-icon.png",
    "docs/screenshots"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node test/run.js",
    "test:node": "node --test test/*.test.js",
    "verify:release": "node scripts/release-audit.mjs"
  }
}
